{
  "schema_version": 1,
  "models": [
    {
      "id": "moment_gmm",
      "display_name": "Moment Gaussian Mixture Model",
      "description": "Dimension-free Gaussian mixture estimator fitted from localized empirical moments.",
      "target": "src_np.gmm.MomentGaussianMixtureModel",
      "default_instance_name": "moment_gmm",
      "parameters": [
        {"key": "s_values", "display_name": "Fixed bandwidths", "description": "Explicit bandwidths, comma separated. Empty uses automatic selection.", "type": "number_array", "default": null, "nullable": true, "exclusive_minimum": 0.0, "advanced": true},
        {"key": "target_neighbor_counts", "display_name": "Target neighbor counts", "description": "Soft-neighbor targets for automatic bandwidth selection.", "type": "integer_array", "default": [100, 70, 50, 30], "nullable": true, "minimum": 1, "min_items": 1, "conflicts_with": ["s_values", "target_neighbor_fractions"]},
        {"key": "target_neighbor_fractions", "display_name": "Target neighbor fractions", "description": "Sample-size-adaptive alternative to neighbor counts.", "type": "number_array", "default": null, "nullable": true, "exclusive_minimum": 0.0, "exclusive_maximum": 1.0, "min_items": 1, "advanced": true, "conflicts_with": ["s_values", "target_neighbor_counts"]},
        {"key": "init", "display_name": "Initialization", "description": "K-means uses the configured component count; Data points creates one initial component per observation.", "type": "enum", "default": "kmeans", "options": [{"value": "kmeans", "display_name": "K-means"}, {"value": "data_points", "display_name": "Data points (K = n)"}]},
        {"key": "n_init", "display_name": "K-means restarts", "description": "Number of K-means initializations. The UI default may differ from the class default.", "type": "integer", "default": 3, "minimum": 1, "maximum": 100},
        {"key": "n_zero_moments", "display_name": "Zeroth-order probes", "description": "Probes per test center.", "type": "integer", "default": 1, "minimum": 0, "maximum": 20},
        {"key": "n_first_moments", "display_name": "First-order probes", "description": "Directional probes per test center.", "type": "integer", "default": 3, "minimum": 0, "maximum": 50},
        {"key": "n_second_moments", "display_name": "Second-order probes", "description": "Directional second-order probes per test center.", "type": "integer", "default": 0, "minimum": 0, "maximum": 50},
        {"key": "n_radial_second_moments", "display_name": "Radial second-order probe", "description": "Enable the direction-free radial probe.", "type": "enum", "default": 0, "options": [{"value": 0, "display_name": "Disabled"}, {"value": 1, "display_name": "Enabled"}], "advanced": true},
        {"key": "second_moment_mode", "display_name": "Second-moment directions", "description": "Direction construction for second-order probes.", "type": "enum", "default": "same_direction", "options": [{"value": "same_direction", "display_name": "Same direction"}, {"value": "two_directions", "display_name": "Two directions"}], "advanced": true},
        {"key": "zero_moment_weight", "display_name": "Zeroth-moment weight", "description": "Loss weight for zeroth-order moments.", "type": "number", "default": 1.0, "minimum": 0.0, "step": 0.1, "advanced": true},
        {"key": "first_moment_weight", "display_name": "First-moment weight", "description": "Loss weight for first-order moments.", "type": "number", "default": 1.0, "minimum": 0.0, "step": 0.1, "advanced": true},
        {"key": "second_moment_weight", "display_name": "Second-moment weight", "description": "Loss weight for directional second-order moments.", "type": "number", "default": 1.0, "minimum": 0.0, "step": 0.1, "advanced": true},
        {"key": "radial_second_moment_weight", "display_name": "Radial-moment weight", "description": "Loss weight for radial second-order moments.", "type": "number", "default": 1.0, "minimum": 0.0, "step": 0.1, "advanced": true},
        {"key": "normalize_moment_losses", "display_name": "Normalize family losses", "description": "Average each family by its test-function count.", "type": "boolean", "default": true, "advanced": true},
        {"key": "scale_normalize_moments", "display_name": "Scale-normalize moments", "description": "Use dimensionless moment responses.", "type": "boolean", "default": true, "advanced": true},
        {"key": "amplitude_optimization", "display_name": "Amplitude optimization", "description": "Constraint for component amplitudes.", "type": "enum", "default": "simplex", "options": [{"value": "simplex", "display_name": "Simplex"}, {"value": "non_negative", "display_name": "Non-negative"}]},
        {"key": "s_optimization", "display_name": "Bandwidth optimization", "description": "Fit bandwidth levels jointly or sequentially.", "type": "enum", "default": "joint", "options": [{"value": "joint", "display_name": "Joint"}, {"value": "sequential", "display_name": "Sequential"}]},
        {"key": "geometry_optimization", "display_name": "Geometry optimization", "description": "Optimize component geometry separately or jointly.", "type": "enum", "default": "component", "options": [{"value": "component", "display_name": "Component-wise"}, {"value": "joint", "display_name": "Joint"}]},
        {"key": "optimizer_mode", "display_name": "Optimizer mode", "description": "Geometry and variance update scheme.", "type": "enum", "default": "legacy", "options": [{"value": "legacy", "display_name": "Legacy"}, {"value": "formula_variance", "display_name": "Formula variance"}, {"value": "joint_variance", "display_name": "Joint variance"}], "advanced": true},
        {"key": "test_center_mode", "display_name": "Test-center mode", "description": "Observed or perturbed data centers.", "type": "enum", "default": "data", "options": [{"value": "data", "display_name": "Observed data"}, {"value": "noisy_data", "display_name": "Noisy data"}], "advanced": true},
        {"key": "n_test_centers", "display_name": "Test-center limit", "description": "Maximum number of data-derived centers; empty means all.", "type": "integer", "default": null, "nullable": true, "minimum": 1, "advanced": true},
        {"key": "test_center_fraction", "display_name": "Retained center fraction", "description": "Fraction of densest centers retained.", "type": "number", "default": 1.0, "exclusive_minimum": 0.0, "maximum": 1.0, "step": 0.05, "advanced": true},
        {"key": "test_center_noise_std", "display_name": "Test-center noise", "description": "Automatic noise calibration.", "type": "string", "default": "auto", "hidden": true},
        {"key": "r_tests_near_means", "display_name": "Tests near means", "description": "Ratio of extra test centers sampled near component means.", "type": "number", "default": 0.0, "minimum": 0.0, "step": 0.05, "advanced": true},
        {"key": "alpha_std_tests", "display_name": "Near-mean noise scale", "description": "Noise scale for centers near estimated means.", "type": "number", "default": 0.1, "minimum": 0.0, "step": 0.05, "advanced": true},
        {"key": "mean_penalty_weight", "display_name": "Mean penalty", "description": "Regularization weight for means.", "type": "number", "default": 0.0, "minimum": 0.0, "step": 0.01, "advanced": true},
        {"key": "weight_entropy_regularization", "display_name": "Weight entropy penalty", "description": "Positive strength penalizes Shannon entropy and uses momentum projected-gradient optimization.", "type": "number", "default": 0.0, "minimum": 0.0, "step": 0.001, "advanced": true},
        {"key": "weight_gini_regularization", "display_name": "Weight Gini penalty", "description": "Strength of the quadratic -||w||² penalty; optimized as a simplex quadratic problem.", "type": "number", "default": 0.0, "minimum": 0.0, "step": 0.001, "advanced": true},
        {"key": "weight_regularization_schedule", "display_name": "Weight regularization schedule", "description": "Decay applied to both entropy and Gini strengths over the outer optimization steps.", "type": "enum", "default": "constant", "options": [{"value": "constant", "display_name": "Constant"}, {"value": "linear", "display_name": "Linear decay"}, {"value": "quadratic", "display_name": "Quadratic decay (1-u²)"}, {"value": "cosine", "display_name": "Cosine decay"}], "advanced": true},
        {"key": "weight_active_set", "display_name": "Weight active set", "description": "Exclude components below active_tol relative to the largest weight from subsequent weight updates.", "type": "boolean", "default": true, "advanced": true},
        {"key": "objective_rtol", "display_name": "Relative tolerance", "description": "Relative objective convergence tolerance.", "type": "number", "default": 0.00001, "minimum": 0.0, "advanced": true},
        {"key": "objective_atol", "display_name": "Absolute tolerance", "description": "Absolute objective convergence tolerance.", "type": "number", "default": 0.0, "minimum": 0.0, "advanced": true},
        {"key": "convergence_patience", "display_name": "Convergence patience", "description": "Consecutive small changes required for convergence.", "type": "integer", "default": 3, "minimum": 1, "maximum": 50, "advanced": true},
        {"key": "random_state", "display_name": "Model random state", "description": "Injected by the runner.", "type": "integer", "default": null, "nullable": true, "hidden": true},
        {"key": "max_steps", "display_name": "Maximum outer steps", "description": "Maximum optimizer outer iterations.", "type": "integer", "default": 50, "minimum": 0, "maximum": 1000},
        {"key": "geom_sweeps", "display_name": "Geometry sweeps", "description": "Geometry sweeps per outer step.", "type": "integer", "default": 1, "minimum": 1, "maximum": 50, "advanced": true},
        {"key": "ls_max_nfev", "display_name": "Least-squares evaluations", "description": "Inner least-squares evaluation limit.", "type": "integer", "default": 30, "minimum": 1, "maximum": 1000, "advanced": true},
        {"key": "active_tol", "display_name": "Active-weight tolerance", "description": "Threshold for active components.", "type": "number", "default": 1e-8, "minimum": 0.0, "advanced": true},
        {"key": "eta_step_bound", "display_name": "Log-variance step bound", "description": "Empty disables the bound.", "type": "number", "default": 0.75, "nullable": true, "exclusive_minimum": 0.0, "advanced": true},
        {"key": "m_step_bound", "display_name": "Mean step bound", "description": "Empty disables the bound.", "type": "number", "default": null, "nullable": true, "exclusive_minimum": 0.0, "advanced": true},
        {"key": "joint_polish_sweeps", "display_name": "Joint polish sweeps", "description": "Optional final joint optimization.", "type": "integer", "default": 0, "minimum": 0, "maximum": 50, "advanced": true},
        {"key": "joint_polish_max_nfev", "display_name": "Joint polish evaluations", "description": "Evaluation limit for each polish sweep.", "type": "integer", "default": null, "nullable": true, "minimum": 1, "advanced": true},
        {"key": "variance_formula_q_bounds", "display_name": "Variance formula q bounds", "description": "Lower and upper clipping bounds.", "type": "number_array", "default": [0.0001, 0.9999], "minimum": 0.0, "maximum": 1.0, "min_items": 2, "max_items": 2, "advanced": true},
        {"key": "leave_one_out", "display_name": "Leave-one-out responses", "description": "Exclude each center's source observation from its response.", "type": "boolean", "default": false, "advanced": true},
        {"key": "experimental_oracle_test_centers", "display_name": "Oracle test centers", "description": "Research-only mechanism.", "type": "boolean", "default": false, "hidden": true},
        {"key": "experimental_uniform_center_fraction", "display_name": "Oracle center fraction", "description": "Research-only mechanism value.", "type": "number", "default": 0.05, "minimum": 0.0, "maximum": 1.0, "hidden": true},
        {"key": "compensated_radial_second_moments", "display_name": "Compensate radial probes", "description": "Subtract the base kernel from radial probes.", "type": "boolean", "default": false, "advanced": true}
      ]
    },
    {
      "id": "smooth_em_gmm",
      "display_name": "Smoothed EM Gaussian Mixture Model",
      "description": "Smooth EM with descent-checked weight updates, a regularized objective, and homogeneous or inhomogeneous spherical variances.",
      "target": "src_np.gmm.SmoothEMGaussianMixtureModel",
      "default_instance_name": "smooth_em_gmm",
      "parameters": [
        {"key": "mode", "display_name": "Mode", "description": "Homogeneous or inhomogeneous spherical variances.", "type": "enum", "default": "inhomogeneous", "options": [{"value": "homogeneous", "display_name": "Homogeneous"}, {"value": "inhomogeneous", "display_name": "Inhomogeneous"}]},
        {"key": "target_neighbor_fraction", "display_name": "Target neighbor fraction", "description": "Target soft-neighbor mass as a fraction of the sample size.", "type": "number", "default": 0.166667, "exclusive_minimum": 0.0, "exclusive_maximum": 1.0, "step": 0.01},
        {"key": "target_neighbor_count", "display_name": "Target neighbor count", "description": "Optional absolute target; when set, it overrides the fraction.", "type": "number", "default": null, "nullable": true, "exclusive_minimum": 0.0, "advanced": true},
        {"key": "n_design_points", "display_name": "Design points", "description": "Number of sampled design points used by the localized moment system.", "type": "integer", "default": 720, "minimum": 1, "maximum": 10000},
        {"key": "base_variance", "display_name": "Known homogeneous variance σ²", "description": "Known spherical variance for the Section 2 homogeneous block and the Section 3 warm-up.", "type": "number", "default": 1.0, "exclusive_minimum": 0.0, "advanced": true},
        {"key": "initial_components", "display_name": "Initial components", "description": "At most 24 initial components by default; empty uses one component per design point for ablation.", "type": "integer", "default": 24, "nullable": true, "minimum": 1, "advanced": true},
        {"key": "regularization", "display_name": "Entropy penalty lambda", "description": "Sparsity penalty used in simplex weight updates. Larger values can remove components, especially when clusters overlap.", "type": "number", "default": 1.0, "minimum": 0.0, "step": 0.01, "advanced": true},
        {"key": "max_steps", "display_name": "Maximum external steps", "description": "Outer Smooth EM blocks; empty uses 3 for homogeneous mode or 7 for inhomogeneous mode.", "type": "integer", "default": null, "nullable": true, "minimum": 0, "maximum": 1000},
        {"key": "internal_steps", "display_name": "Internal steps", "description": "Number of localized moment updates per external step.", "type": "integer", "default": 5, "minimum": 1, "maximum": 100, "advanced": true},
        {"key": "n_directions", "display_name": "Variance directions", "description": "Random directions used for inhomogeneous variance updates.", "type": "integer", "default": 5, "minimum": 1, "maximum": 100, "advanced": true},
        {"key": "min_variance", "display_name": "Minimum variance", "description": "Lower numerical bound for estimated spherical variances.", "type": "number", "default": 0.05, "exclusive_minimum": 0.0, "advanced": true},
        {"key": "max_variance", "display_name": "Maximum variance", "description": "Upper numerical bound for estimated spherical variances.", "type": "number", "default": 8.0, "exclusive_minimum": 0.0, "advanced": true},
        {"key": "active_weight_tol", "display_name": "Active-weight threshold", "description": "Components at or below this simplex weight are pruned; the largest is retained if all are below it.", "type": "number", "default": 0.00000001, "minimum": 0.0, "advanced": true},
        {"key": "objective_rtol", "display_name": "Relative convergence tolerance", "description": "Relative tolerance on the regularized objective after outer blocks; zero with zero absolute tolerance disables early stopping.", "type": "number", "default": 0.0, "minimum": 0.0, "advanced": true},
        {"key": "objective_atol", "display_name": "Absolute convergence tolerance", "description": "Absolute tolerance on the regularized objective after outer blocks.", "type": "number", "default": 0.0, "minimum": 0.0, "advanced": true},
        {"key": "convergence_patience", "display_name": "Convergence patience", "description": "Consecutive stable outer blocks needed for early stopping.", "type": "integer", "default": 2, "minimum": 1, "maximum": 50, "advanced": true},
        {"key": "weight_steps", "display_name": "Weight update steps", "description": "Maximum projected steps per weight update; the solver backtracks whenever the weight objective rises.", "type": "integer", "default": 80, "minimum": 1, "maximum": 1000, "advanced": true},
        {"key": "data_batch_size", "display_name": "Data batch size", "description": "Batch size for empirical moment calculation.", "type": "integer", "default": 4096, "minimum": 1, "advanced": true},
        {"key": "design_batch_size", "display_name": "Design batch size", "description": "Batch size for empirical moment design points.", "type": "integer", "default": 512, "minimum": 1, "advanced": true},
        {"key": "random_state", "display_name": "Model random state", "description": "Injected by the runner.", "type": "integer", "default": null, "nullable": true, "hidden": true}
      ]
    }
  ]
}
